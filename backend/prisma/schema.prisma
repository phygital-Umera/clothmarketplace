generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String        @id @default(uuid())
  username               String?
  email                  String?
  fullname               String
  password               String?
  refreshToken           String?
  address                String?
  isAccessClosed         Boolean       @default(false)
  verifyCode             String?
  verifyCodeExpiry       DateTime?
  isVerified             Boolean       @default(false)
  phoneNumber            String        @unique
  secondaryPhoneNumber   String?
  role                   Role          @default(ADMIN)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?
  companyId              String?
  blockedAt              DateTime?
  blockedById            String?
  blockedReason          String?
  lastLoginAt            DateTime?
  mustChangePassword     Boolean       @default(false)
  passwordResetExpiresAt DateTime?
  passwordResetTokenHash String?       @unique
  status                 AccountStatus @default(ACTIVE)
  branchId               String?
  shopId                 String?
  createdById            String?
  department             String?
  employeeCode           String?       @unique
  employeeRole           String?
  jobTitle               String?
  joiningDate            DateTime?
  permissions            String[]      @default([])
  sessionsRevokedAt      DateTime?
  admin                  Admin?
  branch                 Branch?       @relation(fields: [branchId], references: [id])
  shop                   Shop?         @relation(fields: [shopId], references: [id])
  company                Company?      @relation(fields: [companyId], references: [id])

  orders                 Order[]
  createdProducts        Product[]     @relation("CreatedByUser")
  stockAdjustments       StockAdjustment[]
  assignedTasks          OrderTask[]
  reviews                ProductReview[]
  cart                   Cart?
  addresses              CustomerAddress[]
  returns                ReturnRequest[]
}

model Admin {
  id                  String     @id @default(uuid())
  userId              String     @unique
  amount              Float?
  renewalAmount       Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  accessType          accessType @default(OFFLINE)
  city                String?
  state               String?
  country             String?
  shopName            String?
  district            String?
  logo                String?
  coverImage          String?
  key                 String?
  isUsedKey           Boolean    @default(false)
  extendKey           String?
  extendDays          Int?
  isExtendUsedKey     Boolean?
  BrandColour         String?
  startDate           DateTime?
  expiryDate          DateTime?
  pincode             String?
  contactPersonName   String?
  contactPersonEmail  String?
  contactPersonNumber String?
  user                User       @relation(fields: [userId], references: [id])
}

model Company {
  id            String        @id @default(uuid())
  name          String
  code          String        @unique
  email         String
  contactNumber String
  address       String
  logo          String?
  country       String        @default("India")
  state         String
  city          String
  postalCode    String
  adminName     String
  adminEmail    String
  adminPhone    String
  status        CompanyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  district      String?
  branches      Branch[]
  shops         Shop[]
  users         User[]

  categories    Category[]
  brands        Brand[]
  products      Product[]
  orders        Order[]
  returns       ReturnRequest[]

  @@index([name])
  @@index([status])
}

model RolePermission {
  role       Role
  permission String
  createdAt  DateTime @default(now())

  @@id([role, permission])
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  actorName String?
  actorRole Role?
  action    String
  module    String
  targetId  String?
  companyId String?
  result    AuditResult @default(SUCCESS)
  reason    String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([module, createdAt])
  @@index([actorId])
  @@index([companyId])
  @@index([targetId])
}

model Branch {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  companyId      String
  email          String?
  phone          String?
  alternatePhone String?
  address        String
  postalCode     String
  state          String
  district       String
  city           String
  country        String       @default("India")
  openingTime    String?
  closingTime    String?
  weeklyHolidays String[]     @default([])
  notes          String?
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  company        Company      @relation(fields: [companyId], references: [id])
  users          User[]
  shops          Shop[]

  inventory       Inventory[]
  orders          Order[]
  stockMovements  StockMovement[]

  @@index([companyId])
  @@index([status])
}

/// A shop (counter / outlet) inside a branch; employees work in a shop
model Shop {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  companyId   String
  branchId    String
  email       String?
  phone       String?
  address     String?
  openingTime String?
  closingTime String?
  notes       String?
  status      ShopStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  company     Company    @relation(fields: [companyId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [id])
  users       User[]

  @@index([companyId])
  @@index([branchId])
  @@index([status])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUB_ADMIN
  SHOP_ADMIN
  EMPLOYEE
  USER
}

enum AccountStatus {
  PENDING_INVITATION
  ACTIVE
  INACTIVE
  BLOCKED
}

enum accessType {
  ONLINE
  OFFLINE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum ShopStatus {
  ACTIVE
  INACTIVE
}

// -------------------------------------------------------------
// CLOTHING E-COMMERCE CATALOG & MULTI-BRANCH INVENTORY MODELS
// -------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id])
  name        String
  code        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  displayOrder Int       @default(0)
  seoTitle    String?
  seoDesc     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  subcategories Subcategory[]

  @@index([companyId])
  @@index([code])
}

model Brand {
  id          String    @id @default(uuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  name        String
  code        String    @unique
  logo        String?
  description String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([companyId])
  @@index([code])
}

model Subcategory {
  id           String    @id @default(uuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  code         String    @unique
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@index([code])
}

model Color {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  hexCode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Size {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum GenderTarget {
  MEN
  WOMEN
  UNISEX
  BOYS
  GIRLS
  KIDS
}

model Product {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id])
  name           String
  sku            String          @unique
  shortDesc      String?
  detailedDesc   String?
  tags           String[]        @default([])
  gender         GenderTarget    @default(UNISEX)
  productType    String?         // e.g., T-Shirt, Jeans, Saree, Kurta
  status         ProductStatus   @default(DRAFT)

  // Clothing Attributes
  fabric         String?         // Cotton, Silk, Denim, Linen, etc.
  pattern        String?         // Solid, Striped, Printed, Checked
  fit            String?         // Slim, Regular, Relaxed, Oversized
  sleeveType     String?         // Full, Half, Sleeveless
  neckType       String?         // Round, V-Neck, Polo, Collar
  occasion       String?         // Casual, Formal, Festive, Party
  season         String?         // Summer, Winter, All-Season
  careInstructions String?      // Machine wash, Dry clean only
  countryOfOrigin  String?       @default("India")

  // Pricing & Tax
  mrp            Float           @default(0)
  sellingPrice   Float           @default(0)
  taxRate        Float           @default(5.0) // Typical apparel GST (5% / 12%)
  currency       String          @default("INR")

  // Shipping specifications
  weightKg       Float?
  dimensions     String?         // L x W x H in cm
  returnEligible Boolean         @default(true)
  returnPeriodDays Int           @default(7)

  // SEO metadata
  seoTitle       String?
  seoDesc        String?
  slug           String?         @unique

  createdById    String?
  createdBy      User?           @relation("CreatedByUser", fields: [createdById], references: [id])

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  images         ProductImage[]
  variants       ProductVariant[]
  reviews        ProductReview[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  order     Int      @default(0)
  isMain    Boolean  @default(false)
  isAiGenerated Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantSku     String          @unique
  size           String          // XS, S, M, L, XL, XXL, 32, 34, 36, etc.
  color          String          // Black, Navy, Ivory, Wine, Olive, etc.
  colorHex       String?         // #000000
  image          String?
  mrp            Float?
  sellingPrice   Float?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  inventories    Inventory[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

model Inventory {
  id           String         @id @default(uuid())
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  physicalQty  Int            @default(0)
  reservedQty  Int            @default(0)
  threshold    Int            @default(5)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([branchId, variantId])
  @@index([branchId])
  @@index([variantId])
}

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  RETURN_RESTOCK
  DAMAGE_WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
}

model StockMovement {
  id          String         @id @default(uuid())
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  type        MovementType
  quantity    Int
  prevPhysical Int
  newPhysical  Int
  reason      String
  reference   String?
  performedById String?
  createdAt   DateTime       @default(now())

  @@index([branchId])
  @@index([variantId])
}

model StockAdjustment {
  id          String   @id @default(uuid())
  branchId    String
  variantId   String
  type        String   // INCREASE, DECREASE, CORRECTION
  quantity    Int
  reason      String
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// ORDERS, PAYMENTS, SHIPMENTS & RETURNS
// -------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  IN_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum RefundStatus {
  NONE
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  customerId     String
  customer       User            @relation(fields: [customerId], references: [id])
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])

  status         OrderStatus     @default(PENDING)
  paymentStatus  PaymentStatus   @default(PENDING)
  paymentMethod  String          @default("COD")

  subtotal       Float
  discount       Float           @default(0)
  tax            Float           @default(0)
  shippingFee    Float           @default(0)
  totalAmount    Float

  shippingAddress Json
  trackingNumber String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          OrderItem[]
  tasks          OrderTask[]
  returns        ReturnRequest[]

  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model OrderTask {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo  User     @relation(fields: [assignedToId], references: [id])
  task        String   // e.g., Pick & Pack, Quality Check, Dispatch
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id])
  customerId   String
  customer     User         @relation(fields: [customerId], references: [id])
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  reason       String
  description  String?
  returnStatus ReturnStatus @default(REQUESTED)
  refundAmount Float?
  refundStatus RefundStatus @default(NONE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([companyId])
}

model CustomerAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient  String
  phone      String
  address1   String
  address2   String?
  city       String
  district   String?
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      @default(5)
  title     String?
  comment   String?
  createdAt DateTime @default(now())
}
