# Copy to .env and fill in. Never commit .env.
# Every variable the backend reads is listed here, with NO real values.

# --- Server -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on (frontend VITE_SERVER_URL = http://localhost:<PORT>/api/v1)
PORT=5692
# Comma-separated list of allowed origins for CORS, e.g. http://localhost:5173
CORS_ORIGINS=
# Frontend base URL, used in password reset emails, e.g. http://localhost:5173
FRONTEND_URL=
STORE_URL=
# Number of proxies in front of the API (e.g. 1 behind nginx). Leave empty when
# clients connect directly, so they cannot fake their IP to dodge rate limits
TRUST_PROXY=

# --- Database ---------------------------------------------------------------
# postgresql://<user>:<password>@localhost:5432/<database>?schema=public
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
# Optional, defaults to 12
BCRYPT_SALT_ROUNDS=

# --- Super admin (optional; CLI flags take priority) -------------------------
# npm run create:superadmin -- --email <email> --phone <10 digits> --password <8+ chars>
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- File uploads -------------------------------------------------------------
# Hosted file server; if unreachable, logos are stored in public/uploads
IS_OFFLINE=
HOSTED_BACKEND_URL=
ONLINE_BACKEND_URL=


# --- AI product previews (Cloudflare Workers AI, free tier: 10,000 Neurons/day) --
# Account id: Cloudflare dashboard > Workers AI > "Use REST API"
# Token: create an API token with the "Workers AI" permission. Keep it server-side only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# Optional second Cloudflare account: used automatically when the first one has
# used today's free allowance (or its token is rejected)
CLOUDFLARE_ACCOUNT_ID2=
CLOUDFLARE_AI_API_TOKEN2=
# Optional, defaults to @cf/black-forest-labs/flux-2-klein-4b (colour photos)
CLOUDFLARE_AI_MODEL=
# Optional, defaults to @cf/black-forest-labs/flux-2-klein-9b (professional photos)
CLOUDFLARE_AI_PRO_MODEL=
# true | false (default false). Must not be left empty: remove the line or set a value
CLOUDFLARE_AI_FOR_COLOURS=false

# Optional, used by npm run seed:demo for photo URLs; defaults to http://localhost:<PORT>.
# Leave it commented out unless you need it: an empty value is used as-is.
# ASSET_BASE_URL=https://api.example.com

# Present in older .env files; not read by the current code (SOP_URL too)
SOP_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=

# Razorpay (online payments on the customer store). Test keys start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
