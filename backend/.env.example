# Copy to .env and fill in. Never commit .env.
# Every variable the backend reads is listed here, with NO real values.

# --- Server -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on (frontend VITE_SERVER_URL = http://localhost:<PORT>/api/v1)
PORT=3500
# Comma-separated list of allowed origins for CORS, e.g. http://localhost:5173
CORS_ORIGINS=
# Frontend base URL, used in password reset emails, e.g. http://localhost:5173
FRONTEND_URL=
# Number of proxies in front of the API (e.g. 1 behind nginx). Leave empty when
# clients connect directly, so they cannot fake their IP to dodge rate limits
TRUST_PROXY=

# --- Database ---------------------------------------------------------------
# postgresql://<user>:<password>@localhost:5432/<database>?schema=public
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
# Optional, defaults to 12
BCRYPT_SALT_ROUNDS=

# --- Super admin (optional; CLI flags take priority) -------------------------
# npm run create:superadmin -- --email <email> --phone <10 digits> --password <8+ chars>
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# --- Email (SMTP) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- File uploads -------------------------------------------------------------
# Hosted file server; if unreachable, logos are stored in public/uploads
IS_OFFLINE=
HOSTED_BACKEND_URL=
ONLINE_BACKEND_URL=


# Present in older .env files; not read by the current code (SOP_URL too)
SOP_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=
